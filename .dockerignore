# Git
.git
.gitignore

# Python cache and virtual environment
__pycache__
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Local SQLite databases & ephemeral asset directories
*.sqlite3
media/
staticfiles/

# Environment files (never bake secrets into Docker images)
.env
.env.*
!.env.example

# Development resources and docs not needed in production container
dev-only/
tests/
*.md

# Docker compose files
docker-compose*.yml
