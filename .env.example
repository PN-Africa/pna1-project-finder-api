# ==============================================================================
# Django Configuration
# ==============================================================================
DJANGO_SETTINGS_MODULE=projectfinder.settings.prod
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
DJANGO_LOG_LEVEL=DEBUG

# ==============================================================================
# Database Configuration (Supabase PostgreSQL)
# ==============================================================================
# Option 1: Supabase Connection Pooler (Transaction Mode - Port 6543) [Recommended for Docker / Containers]
# Server-side cursors are automatically disabled for port 6543
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Option 2: Supabase Direct Connection (Session Mode - Port 5432)
# DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require

# Database tuning (optional)
DB_CONN_MAX_AGE=0
DB_SSL_REQUIRE=True
DB_DISABLE_SERVER_SIDE_CURSORS=False

# Legacy individual parameters (fallback if DATABASE_URL is not set)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=postgres
# DB_USER=postgres.[PROJECT_REF]
# DB_PASSWORD=your_password
# DB_HOST=aws-0-[REGION].pooler.supabase.com
# DB_PORT=6543

# ==============================================================================
# CORS & Security
# ==============================================================================
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://app.yourdomain.com,http://localhost:3000
DJANGO_SECURE_SSL_REDIRECT=True

# ==============================================================================
# Docker Container / Deployment Options
# ==============================================================================
PORT=8000
RUN_MIGRATIONS=true
COLLECT_STATIC=true
WAIT_FOR_DB=true

# Email configuration (Optional)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
